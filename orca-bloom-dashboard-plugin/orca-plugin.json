{
  "manifestVersion": 2,
  "id": "bloom-developer-dashboard",
  "name": "Bloom Developer Dashboard",
  "version": "0.2.0",
  "description": "The Bloom dashboard inside Orca: a status bar button that shows the dashboard, and a Worktree panel with the dashboard's row for the focused worktree, its checkout, its Claude session and your last prompts there. Both draw what the dashboard service on this machine computes.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker.ts",
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "dashboard.show",
        "title": "Show the Bloom dashboard"
      },
      {
        "id": "greenhouseWorker.show",
        "title": "Show Bloom Greenhouse"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      }
    ],
    "statusBarItems": [
      {
        "id": "dashboard",
        "text": "Bloom Dashboard",
        "icon": "gauge",
        "tooltip": "Show the Bloom dashboard",
        "command": "dashboard.show",
        "tone": "warning"
      },
      {
        "id": "greenhouse-worker",
        "text": "Bloom Greenhouse",
        "icon": "bot",
        "tooltip": "The Greenhouse worker's settings, and the Greenhouse's status",
        "command": "greenhouseWorker.show"
      }
    ],
    "panels": [
      {
        "id": "worktree",
        "title": "Worktree",
        "icon": "gauge",
        "entry": "panel.html"
      }
    ]
  }
}
