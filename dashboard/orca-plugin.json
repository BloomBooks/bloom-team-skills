{
  "manifestVersion": 2,
  "id": "bloom",
  "name": "Bloom",
  "version": "0.2.0",
  "description": "The Bloom dashboard inside Orca: a status bar button that shows the dashboard, and a Worktree panel with the dashboard's row for the focused worktree, its checkout, its Claude session and your last prompts there. Both draw what the dashboard service on this machine computes.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "plugin/worker.ts",
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "dashboard.show",
        "title": "Show the Bloom dashboard"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      }
    ],
    "statusBarItems": [
      {
        "id": "dashboard",
        "text": "Bloom Dashboard",
        "icon": "gauge",
        "tooltip": "Show the Bloom dashboard",
        "command": "dashboard.show",
        "tone": "warning"
      }
    ],
    "panels": [
      {
        "id": "worktree",
        "title": "Worktree",
        "icon": "gauge",
        "entry": "plugin/panel.html"
      }
    ]
  }
}
