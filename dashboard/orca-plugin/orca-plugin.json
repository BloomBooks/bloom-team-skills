{
  "manifestVersion": 2,
  "id": "bloom-dashboard",
  "name": "Bloom Dashboard",
  "version": "0.1.0",
  "description": "A status bar button that shows the Bloom dashboard, starting its Claude session in the bloom-team-skills checkout when none is open.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "storage:own"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "dashboard.start",
        "title": "Start the Bloom dashboard"
      }
    ],
    "statusBarItems": [
      {
        "id": "dashboard",
        "text": "Bloom Dashboard",
        "icon": "gauge",
        "tooltip": "Show the Bloom dashboard, starting it if it is not running",
        "command": "dashboard.start",
        "tone": "warning"
      }
    ]
  }
}
